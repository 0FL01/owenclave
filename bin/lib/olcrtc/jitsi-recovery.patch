+++ b/internal/engine/jitsi/recovery_test.go
@@ -0,0 +1,28 @@
+package jitsi
+
+import (
+	"context"
+	"testing"
+
+	"github.com/pion/webrtc/v4"
+)
+
+// ai-generated: parked recovery notifies the client once ready, but not after Stop.
+func TestLatePeerRecoveryCallback(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	calls := 0
+	s := &Session{runCtx: ctx, onReconnect: func(*webrtc.DataChannel) { calls++ }}
+	s.notifyLatePeerRecovery()
+	if calls != 1 {
+		t.Fatalf("recovery callbacks = %d, want 1", calls)
+	}
+	s.closed.Store(true)
+	s.notifyLatePeerRecovery()
+	s.closed.Store(false)
+	cancel()
+	s.notifyLatePeerRecovery()
+	if calls != 1 {
+		t.Fatalf("stopped recovery callbacks = %d, want 1", calls)
+	}
+}
