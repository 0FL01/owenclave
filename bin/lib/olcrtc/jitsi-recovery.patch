diff --git a/internal/client/recovery.go b/internal/client/recovery.go
new file mode 100644
--- /dev/null
+++ b/internal/client/recovery.go
@@ -0,0 +1,114 @@
+package client
+
+import (
+	"context"
+
+	"github.com/openlibrecommunity/olcrtc/internal/logger"
+	"github.com/xtaci/smux"
+)
+
+// ai-generated: one pending replacement for a cancelled recovery attempt.
+type recoveryRequest struct {
+	ctx    context.Context //nolint:containedctx // queued work carries its own cancellable generation.
+	reason string
+}
+
+// ai-generated: start the single client-owned recovery execution path.
+func (c *Client) startRecovery(ctx context.Context, cfg Config, cancel context.CancelFunc) {
+	c.reconnectMu.Lock()
+	defer c.reconnectMu.Unlock()
+	workerCtx, stop := context.WithCancel(ctx)
+	c.recoveryCtx = workerCtx
+	c.recoveryStop = stop
+	c.recoveryRequests = make(chan recoveryRequest, 1)
+	c.recoveryDone = make(chan struct{})
+	go func() {
+		defer close(c.recoveryDone)
+		for {
+			select {
+			case <-workerCtx.Done():
+				return
+			case req := <-c.recoveryRequests:
+				if req.ctx.Err() != nil {
+					continue
+				}
+				c.prepareReconnect(req.reason)
+				if req.reason != "liveness" {
+					//nolint:contextcheck // requests inherit workerCtx with replacement cancellation.
+					c.retryHandshake(req.ctx, cfg, cancel, req.reason)
+				}
+			}
+		}
+	}()
+}
+
+// ai-generated: reject liveness recovery from a retired control session.
+func (c *Client) requestLiveRecovery(ctx, controlCtx context.Context) {
+	c.reconnectMu.Lock()
+	defer c.reconnectMu.Unlock()
+	if controlCtx.Err() == nil {
+		c.requestRecovery(ctx, "liveness")
+	}
+}
+
+// ai-generated: publication is atomic with recovery cancellation and shutdown.
+func (c *Client) publishReopenedSession(
+	ctx context.Context, cfg Config, cancel context.CancelFunc,
+	sess *smux.Session, stream *smux.Stream, sid string,
+) bool {
+	c.reconnectMu.Lock()
+	defer c.reconnectMu.Unlock()
+	if ctx.Err() != nil || c.stopped {
+		return false
+	}
+	logger.Infof("session %s reopened (device=%s)", sid, c.deviceID)
+	c.sessMu.Lock()
+	c.session = sess
+	c.controlStrm = stream
+	c.sessionID = sid
+	c.sessMu.Unlock()
+	c.signalSessionReady()
+	c.startControlLoop(ctx, cfg, cancel, stream)
+	return true
+}
+
+// ai-generated: callbacks only cancel stale work and enqueue a replacement.
+func (c *Client) handleReconnect(ctx context.Context, _ Config, _ context.CancelFunc, reason string) {
+	c.reconnectMu.Lock()
+	defer c.reconnectMu.Unlock()
+	c.requestRecovery(ctx, reason)
+}
+
+// ai-generated: called with reconnectMu held, coalescing pending requests.
+func (c *Client) requestRecovery(ctx context.Context, reason string) {
+	if ctx.Err() != nil || c.stopped || c.recoveryRequests == nil {
+		return
+	}
+	if c.recoveryCancel != nil {
+		c.recoveryCancel()
+	}
+	attemptCtx, stop := context.WithCancel(c.recoveryCtx)
+	c.recoveryCancel = stop
+	select {
+	case <-c.recoveryRequests:
+	default:
+	}
+	c.recoveryRequests <- recoveryRequest{ctx: attemptCtx, reason: reason}
+}
+
+// ai-generated: stop rejects further requests and waits for recovery cleanup.
+func (c *Client) stopRecovery() {
+	c.reconnectMu.Lock()
+	c.stopped = true
+	if c.recoveryCancel != nil {
+		c.recoveryCancel()
+	}
+	if c.recoveryStop != nil {
+		c.recoveryStop()
+	}
+	done := c.recoveryDone
+	c.reconnectMu.Unlock()
+	if done != nil {
+		<-done
+	}
+}
