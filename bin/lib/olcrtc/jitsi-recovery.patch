+++ b/internal/client/recovery_test.go
@@ -0,0 +1,197 @@
+package client
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/openlibrecommunity/olcrtc/internal/control"
+	"github.com/openlibrecommunity/olcrtc/internal/handshake"
+	"github.com/openlibrecommunity/olcrtc/internal/muxconn"
+	"github.com/openlibrecommunity/olcrtc/internal/runtime"
+	"github.com/xtaci/smux"
+)
+
+// ai-generated: in-memory recovery carrier with controllable peer readiness.
+type recoveryLink struct {
+	closerLinkStub
+	wait    func(context.Context) error
+	send    func([]byte) error
+	rebuild chan struct{}
+}
+
+// ai-generated: controllable peer readiness for recovery tests.
+func (l *recoveryLink) WaitForPeer(ctx context.Context) error { return l.wait(ctx) }
+
+// ai-generated: forward encrypted smux frames to the test peer.
+func (l *recoveryLink) Send(data []byte) error { return l.send(data) }
+
+// ai-generated: observe liveness requesting a carrier rebuild.
+func (l *recoveryLink) Reconnect(string) { l.rebuild <- struct{}{} }
+
+// ai-generated: bounded channel wait for recovery regression tests.
+func awaitRecovery[T any](t *testing.T, ch <-chan T) T {
+	t.Helper()
+	select {
+	case v := <-ch:
+		return v
+	case <-time.After(20 * time.Second):
+		t.Fatal("recovery event timed out")
+		var zero T
+		return zero
+	}
+}
+
+// ai-generated: initialize one recovery owner without a real carrier.
+func newRecoveryClient(t *testing.T, ln *recoveryLink) (*Client, context.Context, context.CancelFunc) {
+	t.Helper()
+	cipher, err := setupCipher("00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	c := &Client{ln: ln, cipher: cipher, deviceID: "recovery-test",
+		health: runtime.NewHealthTracker(nil), sessionReady: make(chan struct{})}
+	c.startRecovery(ctx, Config{Liveness: control.Config{Interval: time.Hour}}, cancel)
+	t.Cleanup(func() { cancel(); c.shutdown() })
+	return c, ctx, cancel
+}
+
+// ai-generated: exercise real encrypted handshakes beyond the former five-attempt budget.
+func TestRecoveryHandshakeBudgetThenSuccess(t *testing.T) {
+	ln := &recoveryLink{}
+	c, ctx, cancel := newRecoveryClient(t, ln)
+	var mu sync.Mutex
+	var peer *muxconn.Conn
+	var peerSess *smux.Session
+	attempts := 0
+	ln.send = func(data []byte) error {
+		mu.Lock()
+		conn := peer
+		mu.Unlock()
+		if conn != nil {
+			conn.Push(data)
+		}
+		return nil
+	}
+	ln.wait = func(context.Context) error {
+		mu.Lock()
+		defer mu.Unlock()
+		if peerSess != nil {
+			_ = peerSess.Close()
+		}
+		attempts++
+		attempt := attempts
+		serverLink := &recoveryLink{send: func(data []byte) error { c.onData(data); return nil }}
+		peer = muxconn.New(serverLink, c.cipher)
+		var err error
+		peerSess, err = smux.Server(peer, smuxConfig(0))
+		if err != nil {
+			return fmt.Errorf("test smux server: %w", err)
+		}
+		sess := peerSess
+		go func() {
+			stream, acceptErr := sess.AcceptStream()
+			if acceptErr != nil {
+				return
+			}
+			_, _, _ = handshake.Server(stream, func(string, map[string]any) (string, error) {
+				if attempt <= 5 {
+					return "", ErrRemoteNotReady
+				}
+				return "recovered", nil
+			})
+		}()
+		return nil
+	}
+	t.Cleanup(func() {
+		cancel()
+		c.stopRecovery()
+		mu.Lock()
+		defer mu.Unlock()
+		if peerSess != nil {
+			_ = peerSess.Close()
+		}
+	})
+	ready := c.readyChannel()
+	c.handleReconnect(ctx, Config{}, cancel, "carrier")
+	awaitRecovery(t, ready)
+	c.sessMu.RLock()
+	defer c.sessMu.RUnlock()
+	if c.sessionID != "recovered" || c.session == nil {
+		t.Fatalf("session did not recover: %q", c.sessionID)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if attempts != 6 {
+		t.Fatalf("attempts = %d, want 6", attempts)
+	}
+}
+
+// ai-generated: carrier callbacks return while peer wait is blocked; replacement and Stop cancel it.
+func TestRecoveryCallbackCancellationAndStop(t *testing.T) {
+	ln := &recoveryLink{send: func([]byte) error { return nil }}
+	c, ctx, cancel := newRecoveryClient(t, ln)
+	started := make(chan context.Context, 2)
+	ln.wait = func(ctx context.Context) error {
+		started <- ctx
+		<-ctx.Done()
+		return fmt.Errorf("test peer wait: %w", ctx.Err())
+	}
+	callbackDone := make(chan struct{})
+	go func() { c.handleReconnect(ctx, Config{}, cancel, "carrier"); close(callbackDone) }()
+	awaitRecovery(t, callbackDone)
+	first := awaitRecovery(t, started)
+	// ai-generated: replacement inherits the client lifetime, not its cancelled predecessor.
+	c.handleReconnect(first, Config{}, cancel, "carrier")
+	awaitRecovery(t, first.Done())
+	second := awaitRecovery(t, started)
+	c.stopRecovery()
+	awaitRecovery(t, second.Done())
+	c.handleReconnect(ctx, Config{}, cancel, "carrier")
+	c.sessMu.RLock()
+	defer c.sessMu.RUnlock()
+	if c.session != nil || c.sessionID != "" {
+		t.Fatal("stopped recovery published a session")
+	}
+}
+
+// ai-generated: liveness owns carrier rebuilding and waits for its callback before handshaking.
+func TestRecoveryLivenessWaitsForCarrier(t *testing.T) {
+	ln := &recoveryLink{rebuild: make(chan struct{}, 1), send: func([]byte) error { return nil }}
+	c, ctx, cancel := newRecoveryClient(t, ln)
+	started := make(chan struct{}, 1)
+	ln.wait = func(ctx context.Context) error {
+		started <- struct{}{}
+		<-ctx.Done()
+		return fmt.Errorf("test peer wait: %w", ctx.Err())
+	}
+	c.handleReconnect(ctx, Config{}, cancel, "liveness")
+	awaitRecovery(t, ln.rebuild)
+	select {
+	case <-started:
+		t.Fatal("handshake started before carrier recovery")
+	default:
+	}
+	c.handleReconnect(ctx, Config{}, cancel, "carrier")
+	awaitRecovery(t, started)
+}
+
+// ai-generated: even a successful late handshake cannot publish after cancellation or Stop.
+func TestRecoveryRejectsStalePublication(t *testing.T) {
+	c := &Client{sessionReady: make(chan struct{})}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if c.publishReopenedSession(ctx, Config{}, cancel, nil, nil, "stale") {
+		t.Fatal("cancelled handshake published")
+	}
+	c.stopRecovery()
+	if c.publishReopenedSession(context.Background(), Config{}, cancel, nil, nil, "stale") {
+		t.Fatal("stopped client published")
+	}
+	if c.sessionID != "" {
+		t.Fatal("stale session replaced current state")
+	}
+}
