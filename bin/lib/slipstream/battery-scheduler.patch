+#[derive(Default)]
+struct ActivityScheduler {
+    phase: SchedulerPhase,
+    next_sparse_poll_at: u64,
+}
+
+impl ActivityScheduler {
+    fn update(
+        &mut self,
+        streams: usize,
+        last_activity_at: u64,
+        now: u64,
+        has_ready_stream: bool,
+        flow_blocked: bool,
+    ) -> SchedulerPhase {
+        let next = scheduler_phase(
+            streams,
+            last_activity_at,
+            now,
+            has_ready_stream,
+            flow_blocked,
+        );
+        if next != self.phase {
+            if next == SchedulerPhase::Warm
+                || (next == SchedulerPhase::QuiescentOpen && self.phase != SchedulerPhase::Warm)
+            {
+                self.next_sparse_poll_at = now;
+            } else if next == SchedulerPhase::Empty {
+                self.next_sparse_poll_at = 0;
+            }
+            self.phase = next;
+        }
+        next
+    }
+
+    fn sparse_poll_due(&self, now: u64) -> bool {
+        self.phase.poll_interval_us().is_some() && now >= self.next_sparse_poll_at
+    }
+
+    fn record_sparse_poll(&mut self, now: u64, sent: bool) {
+        let Some(interval) = self.phase.poll_interval_us() else {
+            return;
+        };
+        self.next_sparse_poll_at =
+            now.saturating_add(if sent { interval } else { DNS_POLL_SLICE_US });
+    }
+
+    fn timeout_us(
+        &self,
+        quic_delay_us: u64,
+        now: u64,
+        last_activity_at: u64,
+        transport_fast_work: bool,
+    ) -> u64 {
+        if self.phase == SchedulerPhase::Busy || transport_fast_work {
+            return quic_delay_us.clamp(1, DNS_POLL_SLICE_US);
+        }
+        let app_deadline = match self.phase {
+            SchedulerPhase::Warm => Some(
+                self.next_sparse_poll_at
+                    .min(last_activity_at.saturating_add(WARM_WINDOW_US)),
+            ),
+            SchedulerPhase::QuiescentOpen => Some(self.next_sparse_poll_at),
+            _ => None,
+        };
+        app_deadline
+            .map(|deadline| quic_delay_us.min(deadline.saturating_sub(now).max(1)))
+            .unwrap_or(quic_delay_us)
+            .max(1)
+    }
