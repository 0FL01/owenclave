+#[cfg(test)]
+mod domain_mapping_tests {
+    use super::*;
+
+    #[test]
+    fn explicit_mapping_is_total_and_unambiguous() {
+        let paths = vec![
+            parse_path_domain("127.0.0.1:5301=T.X.ass-peak.de.").unwrap(),
+            parse_path_domain("127.0.0.1:5302=tt.x.ass-peak.de").unwrap(),
+        ];
+        let specs: Vec<_> = paths
+            .iter()
+            .map(|(resolver, _)| ResolverSpec {
+                resolver: resolver.clone(),
+                mode: ResolverMode::Authoritative,
+            })
+            .collect();
+        assert_eq!(paths[0].1, "t.x.ass-peak.de");
+        assert!(validate_path_domains(&paths, &specs).is_ok());
+        assert!(validate_path_domains(&[], &specs).is_ok());
+        assert!(validate_path_domains(&paths[..1], &specs).is_err());
+        assert!(validate_path_domains(&[paths[0].clone(), paths[0].clone()], &specs).is_err());
+        let mut reverse = paths.clone();
+        reverse.reverse();
+        assert!(validate_path_domains(&reverse, &specs).is_ok());
+        for value in [
+            "",
+            "127.0.0.1:53",
+            "=test.com",
+            "127.0.0.1:53=",
+            "127.0.0.1:53=a..com",
+            "127.0.0.1:53=a.com=b.com",
+        ] {
+            assert!(parse_path_domain(value).is_err(), "{value}");
+        }
+    }
+
+    #[test]
+    fn shared_mtu_fits_both_suffixes() {
+        use slipstream_dns::{build_qname, encode_query, QueryParams, CLASS_IN, RR_TXT};
+        for domain in ["t.x.ass-peak.de", "tt.x.ass-peak.de"] {
+            for length in 1..=140 {
+                let qname = build_qname(&vec![0xff; length], domain).unwrap();
+                assert!(qname.trim_end_matches('.').len() <= 253);
+                let packet = encode_query(&QueryParams {
+                    id: 1,
+                    qname: &qname,
+                    qtype: RR_TXT,
+                    qclass: CLASS_IN,
+                    rd: true,
+                    cd: false,
+                    qdcount: 1,
+                    is_query: true,
+                })
+                .unwrap();
+                assert!(packet.len() <= 512);
+            }
+        }
+    }
+}
