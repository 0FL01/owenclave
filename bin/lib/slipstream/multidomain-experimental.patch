+fn parse_path_domain(input: &str) -> Result<(HostPort, String), String> {
+    let (endpoint, domain) = input.split_once('=').ok_or("Expected endpoint=domain")?;
+    let domain = parse_domain(domain)?.to_ascii_lowercase();
+    if domain.len() >= 240
+        || domain.split('.').any(|label| {
+            label.is_empty()
+                || label.len() > 63
+                || label.starts_with('-')
+                || label.ends_with('-')
+                || !label
+                    .bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || c == b'-')
+        })
+    {
+        return Err("Invalid DNS path suffix".into());
+    }
+    Ok((parse_resolver(endpoint)?, domain))
+}
+
+fn validate_path_domains(
+    paths: &[(HostPort, String)],
+    resolvers: &[ResolverSpec],
+) -> Result<(), String> {
+    if paths.is_empty() {
+        return Ok(());
+    }
+    if paths.len() != resolvers.len() {
+        return Err("Map every resolver exactly once".into());
+    }
+    for spec in resolvers {
+        if paths
+            .iter()
+            .filter(|(p, _)| p.host == spec.resolver.host && p.port == spec.resolver.port)
+            .count()
+            != 1
+        {
+            return Err("Map every resolver exactly once".into());
+        }
+    }
+    Ok(())
+}
